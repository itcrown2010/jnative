# Maven output only (do not ignore io.jnative.target sources)
/target/
.idea/
*.iml
.classpath
.project
.settings/
*.class
*.ll
.DS_Store
Hello
Arithmetic
IfElse
Loop
Methods
*.exe

# JNative incremental/project caches
.jnative/
**/.jnative/

# Secrets / local credentials (does NOT purge git history)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
.env
.env.*
!**/.env.example
# Keep tracked demo certs if explicitly force-added; prefer not to add private keys:
examples/https/certs/*.key

# Local project locks / demo build outputs
**/jnative.lock
examples/ui-controls-pkg/consumer/build/
examples/jnative-archive/build/
examples/jnative-archive/third_party/build-macos/
examples/jnative-archive/third_party/build-windows/
examples/jnative-archive/third_party/build-linux/
