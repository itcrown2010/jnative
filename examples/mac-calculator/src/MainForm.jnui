{
  "jnui": 1,
  "form": "MainForm",
  "root":
    {
      "type": "Form",
      "name": "MainForm",
      "props": {
        "title": "计算器",
        "width": "326",
        "height": "552"
      },
      "children": [
        {
          "type": "VBox",
