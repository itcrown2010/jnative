package com.demo.greet;

/**
 * @author 张晓达
 */
public class Texts {
    public static int bump(int x) {
        return x + 1;
    }

    /** Package-private: only same language package may call. */
    static int hidden(int x) {
        return x * 10;
    }

    private static int secret() {
        return 99;
    }
}
