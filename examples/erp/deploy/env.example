# JNative One 1.5 — copy locally; never commit real secrets.

JNATIVE_ONE_VERSION=1.5.0-productization
JNATIVE_ONE_TARGET=linux-x86_64

DATABASE_URL=postgresql://jnative_erp@127.0.0.1:5432/jnative_erp
ERP_LISTEN=127.0.0.1:18700
ERP_STATIC_WASM=examples/erp/.jnative/build/browser
ERP_PUBLIC=examples/erp/public
ERP_STORAGE_PATH=./build/erp/storage
ERP_BACKUP_PATH=./build/erp/backups
ERP_LOG_LEVEL=info

# Production must keep DEMO_MODE off
ERP_DEMO_MODE=0

# TLS: terminate at reverse proxy until native TLS product story is verified
# ERP_TLS_CERT=
# ERP_TLS_KEY=
