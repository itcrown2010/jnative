/**
 * Task manager stage 1: create + list using parallel arrays.
 * Usage: add <title...> | list
 */
public class Main {
    static final int MAX = 32;
    static String[] titles = new String[MAX];
    static int count = 0;

    public static void main(String[] args) {
        if (args.length == 0) {
            System.out.println("usage: add <title> | list");
            return;
        }
        String cmd = args[0];
        if (cmd.compareTo("demo") == 0) {
            /* 单进程演示：进程退出后内存状态不会保留 */
            String[] a1 = new String[3];
            a1[0] = "add"; a1[1] = "Buy"; a1[2] = "milk";
            main(a1);
            String[] a2 = new String[3];
            a2[0] = "add"; a2[1] = "Write"; a2[2] = "docs";
            main(a2);
            String[] a3 = new String[1];
            a3[0] = "list";
            main(a3);
            return;
        }
        if (cmd.compareTo("add") == 0) {
            if (args.length < 2) {
                System.out.println("error: missing title");
                return;
            }
            String title = joinFrom(args, 1);
            if (count >= MAX) {
                System.out.println("error: full");
                return;
            }
            titles[count] = title;
            count = count + 1;
            System.out.println("added " + String.valueOf(count - 1));
            return;
        }
        if (cmd.compareTo("list") == 0) {
            int i = 0;
            while (i < count) {
                System.out.println(String.valueOf(i) + ": " + titles[i]);
                i = i + 1;
            }
            System.out.println("total=" + String.valueOf(count));
            return;
        }
        System.out.println("error: unknown command");
    }

    static String joinFrom(String[] args, int start) {
        String s = args[start];
        int i = start + 1;
        while (i < args.length) {
            s = s + " " + args[i];
            i = i + 1;
        }
        return s;
    }
}
