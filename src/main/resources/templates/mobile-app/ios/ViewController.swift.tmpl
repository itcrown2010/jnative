import UIKit
import WebKit

final class ViewController: UIViewController, WKNavigationDelegate {
    private var webView: WKWebView!
    private var bridge: BridgeHost!

    override func viewDidLoad() {
        super.viewDidLoad()
        view.backgroundColor = .systemBackground
        let config = WKWebViewConfiguration()
        config.preferences.setValue(true, forKey: "allowFileAccessFromFileURLs")
        let webView = WKWebView(frame: .zero, configuration: config)
        webView.translatesAutoresizingMaskIntoConstraints = false
        webView.navigationDelegate = self
        webView.scrollView.contentInsetAdjustmentBehavior = .always
        #if DEBUG
        if #available(iOS 16.4, *) {
            webView.isInspectable = true
        }
        #endif
        view.addSubview(webView)
        NSLayoutConstraint.activate([
            webView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            webView.bottomAnchor.constraint(equalTo: view.safeAreaLayoutGuide.bottomAnchor),
            webView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            webView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
        ])
        self.webView = webView
        let bridge = BridgeHost(webView: webView)
        config.userContentController.add(bridge, name: "jnativeBridge")
        self.bridge = bridge
        if let www = Bundle.main.resourceURL?.appendingPathComponent("www", isDirectory: true) {
            webView.loadFileURL(www.appendingPathComponent("index.html"), allowingReadAccessTo: www)
        }
    }

    override func viewDidAppear(_ animated: Bool) {
        super.viewDidAppear(animated)
        bridge.emitLifecycle("lifecycle.foreground")
    }

    override func viewWillDisappear(_ animated: Bool) {
        bridge.emitLifecycle("lifecycle.background")
        super.viewWillDisappear(animated)
    }

    deinit { bridge?.destroy() }

    func webView(_ webView: WKWebView, decidePolicyFor navigationAction: WKNavigationAction,
                 decisionHandler: @escaping (WKNavigationActionPolicy) -> Void) {
        guard let url = navigationAction.request.url else { decisionHandler(.allow); return }
        if url.isFileURL { decisionHandler(.allow); return }
        UIApplication.shared.open(url)
        decisionHandler(.cancel)
    }
}
